{
  "name": "tvtrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal local-only TV tracker (TV Time clone)",
  "workspaces": [
    "packages/model",
    "server",
    "client"
  ],
  "scripts": {
    "server": "npm run dev -w @tvtrack/server",
    "client": "npm run dev -w @tvtrack/client",
    "dev:server": "npm run dev -w @tvtrack/server",
    "dev:client": "npm run dev -w @tvtrack/client",
    "docker:up": "docker compose up -d --build",
    "docker:update": "docker compose up -d --build",
    "docker:stop": "docker compose stop",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:status": "docker compose ps",
    "build": "npm run build -w @tvtrack/model && npm run build -w @tvtrack/server && npm run build -w @tvtrack/client",
    "test": "npm run test -w @tvtrack/server --if-present"
  }
}
